<Page
    x:Class="ClinicQueueManager.Views.PatientsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Style="{StaticResource PageRoot}">

    <Grid Margin="28,24,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource SectionTitle}" Text="Pacjenci" />
            <TextBlock Style="{StaticResource SectionSubtitle}" Text="Zarządzanie danymi pacjentów." />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource FilterBar}">
            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Margin="0,0,8,0"
                           Text="Szukaj (imię, nazwisko, PESEL, telefon):" />
                <TextBox x:Name="SearchTextBox"
                         Width="280"
                         MinHeight="28"
                         KeyDown="SearchTextBox_KeyDown" />
                <Button Margin="8,0,0,0" Style="{StaticResource BtnSecondary}" Content="Szukaj" Click="Search_Click" />
                <Button Margin="8,0,0,0" Style="{StaticResource BtnClear}" Content="Wyczyść filtr" Click="ClearSearch_Click" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" MinHeight="400">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,12,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardHeader}" Text="Lista pacjentów" />
                    <DataGrid x:Name="PatientsGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionChanged="PatientsGrid_SelectionChanged"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="45" />
                            <DataGridTextColumn Header="Imię" Binding="{Binding FirstName}" Width="100" />
                            <DataGridTextColumn Header="Nazwisko" Binding="{Binding LastName}" Width="120" />
                            <DataGridTextColumn Header="PESEL" Binding="{Binding Pesel}" Width="110" />
                            <DataGridTextColumn Header="Data urodzenia" Binding="{Binding DateOfBirth, StringFormat=yyyy-MM-dd}" Width="110" />
                            <DataGridTextColumn Header="Telefon" Binding="{Binding PhoneNumber}" Width="110" />
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="150" />
                            <DataGridTextColumn Header="Adres" Binding="{Binding Address}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource FormCard}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="640">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardHeader}" Text="Formularz pacjenta" />

                        <TextBlock Style="{StaticResource FormLabel}" Text="Imię" />
                        <TextBox x:Name="FirstNameBox" MinHeight="28" />

                        <TextBlock Style="{StaticResource FormLabel}" Text="Nazwisko" />
                        <TextBox x:Name="LastNameBox" MinHeight="28" />

                        <TextBlock Style="{StaticResource FormLabel}" Text="PESEL (11 cyfr)" />
                        <TextBox x:Name="PeselBox" MinHeight="28" MaxLength="11" />

                        <TextBlock Style="{StaticResource FormLabel}" Text="Data urodzenia" />
                        <DatePicker x:Name="BirthDatePicker" />

                        <TextBlock Style="{StaticResource FormLabel}" Text="Telefon" />
                        <TextBox x:Name="PhoneBox" MinHeight="28" />

                        <TextBlock Style="{StaticResource FormLabel}" Text="Email" />
                        <TextBox x:Name="EmailBox" MinHeight="28" />

                        <TextBlock Style="{StaticResource FormLabel}" Text="Adres" />
                        <TextBox x:Name="AddressBox" Height="56" TextWrapping="Wrap" AcceptsReturn="True" />

                        <WrapPanel Margin="0,16,0,0">
                            <Button Style="{StaticResource BtnAdd}" Content="Dodaj" Click="Add_Click" />
                            <Button Style="{StaticResource BtnSave}" Content="Zapisz zmiany" Click="Save_Click" />
                            <Button Style="{StaticResource BtnDelete}" Content="Usuń" Click="Delete_Click" />
                            <Button Style="{StaticResource BtnClear}" Content="Wyczyść formularz" Click="Clear_Click" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
