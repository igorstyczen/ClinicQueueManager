<Window
    x:Class="ClinicQueueManager.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MediQueue"
    Height="860"
    Width="1360"
    MinHeight="700"
    MinWidth="1100"
    FontFamily="Segoe UI"
    Background="{StaticResource PageBackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="272" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,4">
                    <Border Margin="14,20,14,0"
                            Padding="14,12"
                            CornerRadius="10"
                            Background="{StaticResource SidebarHeaderBrush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#6EE7B7"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"
                                       Text="✚" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           Text="MediQueue" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="11"
                                           Foreground="{StaticResource SidebarMutedBrush}"
                                           Text="System zarządzania przychodnią" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Separator Margin="16,14,16,4" Background="{StaticResource SidebarHoverBrush}" />
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource NavSectionHeader}" Text="GŁÓWNE" />
                        <Button x:Name="NavDashboard"
                                Style="{StaticResource NavButtonActive}"
                                Content="▦  Dashboard"
                                Click="Dashboard_Click" />

                        <TextBlock Style="{StaticResource NavSectionHeader}" Text="OBSŁUGA PACJENTA" />
                        <Button x:Name="NavPatients"
                                Style="{StaticResource NavButton}"
                                Content="+  Pacjenci"
                                Click="Patients_Click" />
                        <Button x:Name="NavAppointments"
                                Style="{StaticResource NavButton}"
                                Content="+  Wizyty"
                                Click="Appointments_Click" />

                        <TextBlock Style="{StaticResource NavSectionHeader}" Text="ZASOBY PRZYCHODNI" />
                        <Button x:Name="NavDoctors"
                                Style="{StaticResource NavButton}"
                                Content="+  Lekarze"
                                Click="Doctors_Click" />
                        <Button x:Name="NavOffices"
                                Style="{StaticResource NavButton}"
                                Content="+  Gabinety"
                                Click="Offices_Click" />
                        <Button x:Name="NavSpecializations"
                                Style="{StaticResource NavButton}"
                                Content="+  Specjalizacje"
                                Click="Specializations_Click" />
                    </StackPanel>
                </ScrollViewer>

                <TextBlock Grid.Row="2"
                           Margin="20,10,20,18"
                           FontSize="10"
                           Foreground="{StaticResource SidebarMutedBrush}"
                           Text="PO2 • WPF • SQLite" />
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Background="{StaticResource PageBackgroundBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="1,0,0,0">
            <Frame x:Name="ContentFrame"
                   Background="Transparent"
                   NavigationUIVisibility="Hidden" />
        </Border>
    </Grid>
</Window>
