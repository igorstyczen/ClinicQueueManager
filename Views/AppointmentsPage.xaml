<Page
    x:Class="ClinicQueueManager.Views.AppointmentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Style="{StaticResource PageRoot}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28,24,28,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Style="{StaticResource SectionTitle}" Text="Wizyty" />
                <TextBlock Style="{StaticResource SectionSubtitle}"
                           Text="Inteligentny asystent rejestracji wizyt — priorytet, ocena terminu i sugestia wcześniejszego slotu." />
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource FilterBar}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="Status:" />
                        <ComboBox x:Name="FilterStatusCombo" Width="140" Margin="0,0,16,0" MinHeight="28" IsEditable="False" />
                        <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="Priorytet:" />
                        <ComboBox x:Name="FilterPriorityCombo" Width="120" Margin="0,0,16,0" MinHeight="28" IsEditable="False" />
                        <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="Lekarz:" />
                        <ComboBox x:Name="FilterDoctorCombo"
                                  Width="220"
                                  MinHeight="28"
                                  Margin="0,0,0,0"
                                  IsEditable="False"
                                  DisplayMemberPath="Display"
                                  SelectionChanged="FilterDoctor_Changed" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="Szukaj (pacjent, lekarz):" />
                        <TextBox x:Name="FilterSearchBox"
                                 Width="220"
                                 MinHeight="28"
                                 KeyDown="FilterSearchBox_KeyDown" />
                        <Button Margin="8,0,0,0" Style="{StaticResource BtnSecondary}" Content="Filtruj" Click="Filter_Click" />
                        <Button Margin="8,0,0,0" Style="{StaticResource BtnClear}" Content="Wyczyść filtr" Click="ClearFilters_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2" MinHeight="400">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,12,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardHeader}" Text="Lista wizyt" />
                        <DataGrid x:Name="AppointmentsGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  SelectionChanged="AppointmentsGrid_SelectionChanged"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="45" />
                                <DataGridTextColumn Header="Data" Binding="{Binding Date}" Width="90" />
                                <DataGridTextColumn Header="Godzina" Binding="{Binding Time}" Width="65" />
                                <DataGridTextColumn Header="Czas trwania" Binding="{Binding Duration}" Width="85" />
                                <DataGridTextColumn Header="Typ wizyty" Binding="{Binding VisitType}" Width="120" />
                                <DataGridTextColumn Header="Pacjent" Binding="{Binding Patient}" Width="120" />
                                <DataGridTextColumn Header="Lekarz" Binding="{Binding Doctor}" Width="130" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="85" />
                                <DataGridTextColumn Header="Priorytet"
                                                    Binding="{Binding Priority}"
                                                    Width="75"
                                                    ElementStyle="{StaticResource PriorityCellTextStyle}" />
                                <DataGridTextColumn Header="Powód" Binding="{Binding Reason}" Width="110" />
                                <DataGridTextColumn Header="Objawy" Binding="{Binding Symptoms}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource FormCard}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="780">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardHeader}" Text="Formularz wizyty" />

                            <TextBlock Style="{StaticResource FormLabel}" Text="Pacjent" />
                            <ComboBox x:Name="PatientCombo"
                                      MinHeight="28"
                                      IsEditable="False"
                                      DisplayMemberPath="Display"
                                      SelectionChanged="PatientCombo_SelectionChanged" />

                            <TextBlock Style="{StaticResource FormLabel}" Text="Lekarz" />
                            <ComboBox x:Name="DoctorCombo"
                                      MinHeight="28"
                                      IsEditable="False"
                                      DisplayMemberPath="Display"
                                      SelectionChanged="DoctorCombo_SelectionChanged" />

                            <TextBlock Style="{StaticResource FormLabel}" Text="Data wizyty" />
                            <DatePicker x:Name="AppointmentDatePicker"
                                        SelectedDateChanged="AppointmentSchedule_Changed" />

                            <TextBlock Style="{StaticResource FormLabel}" Text="Godzina wizyty" />
                            <ComboBox x:Name="TimeCombo"
                                      MinHeight="28"
                                      IsEditable="False"
                                      SelectionChanged="AppointmentSchedule_Changed" />

                            <TextBlock Style="{StaticResource FormLabel}" Text="Status wizyty" />
                            <ComboBox x:Name="StatusCombo"
                                      MinHeight="28"
                                      IsEditable="False" />

                            <TextBlock Style="{StaticResource FormLabel}" Text="Typ wizyty" />
                            <ComboBox x:Name="VisitTypeCombo"
                                      MinHeight="28"
                                      IsEditable="False"
                                      SelectionChanged="VisitTypeCombo_SelectionChanged" />

                            <TextBlock Style="{StaticResource FormLabel}" Text="Powód wizyty" />
                            <TextBox x:Name="ReasonBox"
                                     Height="56"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     TextChanged="ReasonBox_TextChanged" />

                            <TextBlock Style="{StaticResource FormLabel}" Text="Objawy (zaznacz wszystkie występujące)" />
                            <Border BorderBrush="#DDE1E6" BorderThickness="1" Padding="8" MaxHeight="160">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="SymptomsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Margin="0,3"
                                                          Content="{Binding Display}"
                                                          IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Checked="Symptom_CheckedChanged"
                                                          Unchecked="Symptom_CheckedChanged" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>

                            <Border Background="#ECFDF5"
                                    BorderBrush="{StaticResource AppBorderBrush}"
                                    BorderThickness="1"
                                    Padding="12"
                                    CornerRadius="8"
                                    Margin="0,10,0,8">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Text="Ocena triage (objawy i wiek)" />
                                    <TextBlock x:Name="PointsText"
                                              Margin="0,8,0,0"
                                              FontWeight="SemiBold"
                                              Text="Suma punktów: 0" />
                                    <TextBlock x:Name="PriorityText"
                                              FontSize="14"
                                              Margin="0,6,0,0"
                                              Text="Wyliczony priorytet: —" />
                                    <TextBlock x:Name="MedicalRecommendationText"
                                              Margin="0,8,0,0"
                                              TextWrapping="Wrap"
                                              Foreground="{StaticResource TextPrimaryBrush}"
                                              Text="Rekomendacja medyczna: —" />
                                    <TextBlock x:Name="SymptomsExplanationText"
                                              Margin="0,6,0,0"
                                              TextWrapping="Wrap"
                                              Foreground="{StaticResource TextSecondaryBrush}"
                                              FontSize="12"
                                              Text="Uzasadnienie objawów: —" />
                                </StackPanel>
                            </Border>

                            <Border Background="#FFFFFF"
                                    BorderBrush="{StaticResource AppBorderBrush}"
                                    BorderThickness="1"
                                    Padding="12"
                                    CornerRadius="8"
                                    Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Text="Inteligentna rekomendacja terminu" />
                                    <TextBlock x:Name="SelectedTermText"
                                              Margin="0,8,0,0"
                                              TextWrapping="Wrap"
                                              Text="Wybrany termin: —" />
                                    <TextBlock x:Name="TermEvaluationText"
                                              Margin="0,6,0,0"
                                              TextWrapping="Wrap"
                                              FontWeight="SemiBold"
                                              Foreground="{StaticResource AccentMintBrush}"
                                              Text="Ocena terminu: —" />
                                    <TextBlock x:Name="SuggestedTermText"
                                              Margin="0,6,0,0"
                                              TextWrapping="Wrap"
                                              Text="Sugerowany termin: brak" />
                                    <TextBlock x:Name="SchedulerExplanationText"
                                              Margin="0,6,0,0"
                                              TextWrapping="Wrap"
                                              FontSize="12"
                                              Foreground="{StaticResource TextSecondaryBrush}"
                                              Text="Uzasadnienie: —" />
                                    <Button x:Name="UseSuggestedTermButton"
                                            Margin="0,10,0,0"
                                            Style="{StaticResource BtnSecondary}"
                                            Content="Użyj sugerowanego terminu"
                                            IsEnabled="False"
                                            Click="UseSuggestedTerm_Click" />
                                    <TextBlock Margin="0,10,0,0"
                                              FontSize="11"
                                              TextWrapping="Wrap"
                                              Foreground="{StaticResource TextSecondaryBrush}"
                                              Text="System nie zmienia automatycznie harmonogramu. Rekomendacja jest pomocą dla personelu rejestracji." />
                                </StackPanel>
                            </Border>

                            <Border Background="#FFFFFF"
                                    BorderBrush="{StaticResource AppBorderBrush}"
                                    BorderThickness="1"
                                    Padding="12"
                                    CornerRadius="8"
                                    Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Text="Inteligentna podpowiedź czasu wizyty" />
                                    <TextBlock x:Name="SelectedVisitTypeText"
                                              Margin="0,8,0,0"
                                              TextWrapping="Wrap"
                                              Text="Wybrany typ wizyty: —" />
                                    <TextBlock x:Name="SuggestedDurationText"
                                              Margin="0,6,0,0"
                                              FontWeight="SemiBold"
                                              Text="Sugerowany czas wizyty: —" />
                                    <TextBlock x:Name="DurationExplanationText"
                                              Margin="0,6,0,0"
                                              TextWrapping="Wrap"
                                              FontSize="12"
                                              Foreground="{StaticResource TextSecondaryBrush}"
                                              Text="Uzasadnienie: —" />
                                    <TextBlock x:Name="PriorityWarningText"
                                              Margin="0,8,0,0"
                                              TextWrapping="Wrap"
                                              FontSize="12"
                                              Foreground="#C2410C"
                                              FontWeight="SemiBold"
                                              Visibility="Collapsed"
                                              Text="" />
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Czas trwania wizyty" />
                                    <ComboBox x:Name="DurationCombo"
                                              MinHeight="28"
                                              IsEditable="False"
                                              SelectionChanged="DurationCombo_SelectionChanged" />
                                    <Button x:Name="UseSuggestedDurationButton"
                                            Margin="0,10,0,0"
                                            Style="{StaticResource BtnSecondary}"
                                            Content="Użyj sugerowanego czasu"
                                            IsEnabled="False"
                                            Click="UseSuggestedDuration_Click" />
                                </StackPanel>
                            </Border>

                            <WrapPanel Margin="0,8,0,0">
                                <Button Style="{StaticResource BtnAdd}" Content="Dodaj wizytę" Click="Add_Click" />
                                <Button Style="{StaticResource BtnSave}" Content="Zapisz zmiany" Click="Save_Click" />
                                <Button Style="{StaticResource BtnDelete}" Content="Usuń" Click="Delete_Click" />
                                <Button Style="{StaticResource BtnClear}" Content="Wyczyść formularz" Click="Clear_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
