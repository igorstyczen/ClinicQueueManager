<Page
    x:Class="ClinicQueueManager.Views.DoctorsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Style="{StaticResource PageRoot}">

    <Grid Margin="28,24,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource SectionTitle}" Text="Lekarze" />
            <TextBlock Style="{StaticResource SectionSubtitle}"
                       Text="Zarządzanie lekarzami — przypisanie specjalizacji i gabinetu." />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource FilterBar}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="Filtr specjalizacji:" />
                    <ComboBox x:Name="FilterSpecCombo"
                              Width="240"
                              MinHeight="28"
                              IsEditable="False"
                              DisplayMemberPath="Name"
                              SelectionChanged="FilterSpec_Changed" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,8,0"
                               Text="Szukaj (imię, nazwisko, email, telefon):" />
                    <TextBox x:Name="SearchTextBox"
                             Width="260"
                             MinHeight="28"
                             KeyDown="SearchTextBox_KeyDown" />
                    <Button Margin="8,0,0,0" Style="{StaticResource BtnSecondary}" Content="Szukaj" Click="Search_Click" />
                    <Button Margin="8,0,0,0" Style="{StaticResource BtnClear}" Content="Wyczyść filtr" Click="ClearFilters_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" MinHeight="400">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,12,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardHeader}" Text="Lista lekarzy" />
                    <DataGrid x:Name="DoctorsGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionChanged="DoctorsGrid_SelectionChanged"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="45" />
                            <DataGridTextColumn Header="Imię" Binding="{Binding FirstName}" Width="100" />
                            <DataGridTextColumn Header="Nazwisko" Binding="{Binding LastName}" Width="120" />
                            <DataGridTextColumn Header="Specjalizacja" Binding="{Binding SpecializationName}" Width="130" />
                            <DataGridTextColumn Header="Gabinet" Binding="{Binding OfficeNumber}" Width="85" />
                            <DataGridTextColumn Header="Telefon" Binding="{Binding PhoneNumber}" Width="110" />
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource FormCard}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="640">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardHeader}" Text="Formularz lekarza" />

                        <TextBlock Style="{StaticResource FormLabel}" Text="Imię" />
                        <TextBox x:Name="FirstNameBox" MinHeight="28" />

                        <TextBlock Style="{StaticResource FormLabel}" Text="Nazwisko" />
                        <TextBox x:Name="LastNameBox" MinHeight="28" />

                        <TextBlock Style="{StaticResource FormLabel}" Text="Telefon" />
                        <TextBox x:Name="PhoneBox" MinHeight="28" />

                        <TextBlock Style="{StaticResource FormLabel}" Text="Email" />
                        <TextBox x:Name="EmailBox" MinHeight="28" />

                        <TextBlock Style="{StaticResource FormLabel}" Text="Specjalizacja" />
                        <ComboBox x:Name="SpecCombo"
                                  MinHeight="28"
                                  IsEditable="False"
                                  DisplayMemberPath="Name" />

                        <TextBlock Style="{StaticResource FormLabel}" Text="Gabinet" />
                        <ComboBox x:Name="OfficeCombo"
                                  MinHeight="28"
                                  IsEditable="False"
                                  DisplayMemberPath="Display" />

                        <WrapPanel Margin="0,16,0,0">
                            <Button Style="{StaticResource BtnAdd}" Content="Dodaj lekarza" Click="Add_Click" />
                            <Button Style="{StaticResource BtnSave}" Content="Zapisz zmiany" Click="Save_Click" />
                            <Button Style="{StaticResource BtnDelete}" Content="Usuń" Click="Delete_Click" />
                            <Button Style="{StaticResource BtnClear}" Content="Wyczyść formularz" Click="Clear_Click" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
