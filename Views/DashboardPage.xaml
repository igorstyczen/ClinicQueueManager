<Page
    x:Class="ClinicQueueManager.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Style="{StaticResource PageRoot}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,28">

            <TextBlock Style="{StaticResource SectionTitle}" Text="Dashboard" />
            <TextBlock Style="{StaticResource SectionSubtitle}"
                       Text="Dzisiejszy panel przychodni i najważniejsze wizyty." />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,28">
                <Border Style="{StaticResource StatTileAccent}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Text="Pacjenci" />
                        <TextBlock x:Name="PatientsCountText"
                                   Margin="0,6,0,0"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentMintBrush}"
                                   Text="0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatTileAccent}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Text="Lekarze" />
                        <TextBlock x:Name="DoctorsCountText"
                                   Margin="0,6,0,0"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentMintBrush}"
                                   Text="0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatTileAccent}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Text="Wizyty dzisiaj" />
                        <TextBlock x:Name="TodayVisitsCountText"
                                   Margin="0,6,0,0"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentGreenBrush}"
                                   Text="0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatTileUrgent}" Margin="0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Text="Pilne dzisiaj" />
                        <TextBlock x:Name="UrgentTodayCountText"
                                   Margin="0,6,0,0"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentRedBrush}"
                                   Text="0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <TextBlock Style="{StaticResource CardHeader}" Margin="0,0,0,10" Text="Dzisiejszy harmonogram" />
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,28" Padding="16">
                <StackPanel>
                    <TextBlock x:Name="TodayScheduleEmptyText"
                               Text="Brak wizyt zaplanowanych na dzisiaj."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="14"
                               Margin="4,8"
                               Visibility="Collapsed" />
                    <DataGrid x:Name="TodayScheduleGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              MaxHeight="280"
                              Visibility="Visible">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Godzina" Binding="{Binding Time}" Width="70" />
                            <DataGridTextColumn Header="Pacjent" Binding="{Binding Patient}" Width="140" />
                            <DataGridTextColumn Header="Lekarz" Binding="{Binding Doctor}" Width="140" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                            <DataGridTextColumn Header="Priorytet"
                                                Binding="{Binding Priority}"
                                                Width="90"
                                                ElementStyle="{StaticResource PriorityCellTextStyle}" />
                            <DataGridTextColumn Header="Typ wizyty" Binding="{Binding VisitType}" Width="130" />
                            <DataGridTextColumn Header="Powód" Binding="{Binding Reason}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource CardHeader}" Margin="0,0,0,10" Text="Pilne przypadki" />
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,28" Padding="16">
                <StackPanel>
                    <TextBlock x:Name="UrgentCasesEmptyText"
                               Text="Brak pilnych przypadków."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="14"
                               Margin="4,8"
                               Visibility="Collapsed" />
                    <DataGrid x:Name="UrgentCasesGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              MaxHeight="220"
                              Visibility="Visible">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Data" Binding="{Binding Date}" Width="100" />
                            <DataGridTextColumn Header="Godzina" Binding="{Binding Time}" Width="70" />
                            <DataGridTextColumn Header="Pacjent" Binding="{Binding Patient}" Width="130" />
                            <DataGridTextColumn Header="Telefon" Binding="{Binding PatientPhone}" Width="110" />
                            <DataGridTextColumn Header="Lekarz" Binding="{Binding Doctor}" Width="130" />
                            <DataGridTextColumn Header="Priorytet"
                                                Binding="{Binding Priority}"
                                                Width="90"
                                                ElementStyle="{StaticResource PriorityCellTextStyle}" />
                            <DataGridTextColumn Header="Powód" Binding="{Binding Reason}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource CardHeader}" Margin="0,0,0,10" Text="Najbliższe przyszłe wizyty" />
            <Border Style="{StaticResource CardBorder}" Padding="16">
                <StackPanel>
                    <TextBlock x:Name="FutureVisitsEmptyText"
                               Text="Brak zaplanowanych wizyt w kolejnych dniach."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="14"
                               Margin="4,8"
                               Visibility="Collapsed" />
                    <DataGrid x:Name="FutureVisitsGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              MaxHeight="200"
                              Visibility="Visible">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Data" Binding="{Binding Date}" Width="100" />
                            <DataGridTextColumn Header="Godzina" Binding="{Binding Time}" Width="70" />
                            <DataGridTextColumn Header="Pacjent" Binding="{Binding Patient}" Width="150" />
                            <DataGridTextColumn Header="Lekarz" Binding="{Binding Doctor}" Width="150" />
                            <DataGridTextColumn Header="Priorytet"
                                                Binding="{Binding Priority}"
                                                Width="90"
                                                ElementStyle="{StaticResource PriorityCellTextStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
