<?xml version="1.0" encoding="utf-8"?>

<Application

    x:Class="ClinicQueueManager.App"

    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    StartupUri="Views/MainWindow.xaml">

    <Application.Resources>

        <!-- Paleta MediQueue — zielono-medyczna -->

        <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F0FDF4" />

        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />

        <SolidColorBrush x:Key="SidebarBrush" Color="#064E3B" />

        <SolidColorBrush x:Key="SidebarHoverBrush" Color="#047857" />

        <SolidColorBrush x:Key="SidebarActiveBrush" Color="#10B981" />

        <SolidColorBrush x:Key="SidebarHeaderBrush" Color="#047857" />

        <SolidColorBrush x:Key="SidebarTextBrush" Color="#ECFDF5" />

        <SolidColorBrush x:Key="SidebarMutedBrush" Color="#A7F3D0" />

        <SolidColorBrush x:Key="AppBorderBrush" Color="#D1FAE5" />

        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#111827" />

        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#64748B" />

        <SolidColorBrush x:Key="AccentGreenBrush" Color="#16A34A" />

        <SolidColorBrush x:Key="AccentSaveBrush" Color="#059669" />

        <SolidColorBrush x:Key="AccentRedBrush" Color="#DC2626" />

        <SolidColorBrush x:Key="AccentGrayBrush" Color="#64748B" />

        <SolidColorBrush x:Key="AccentMintBrush" Color="#10B981" />

        <SolidColorBrush x:Key="AccentBlueBrush" Color="#10B981" />

        <SolidColorBrush x:Key="PriorityUrgentBrush" Color="#DC2626" />

        <SolidColorBrush x:Key="PriorityHighBrush" Color="#F97316" />

        <SolidColorBrush x:Key="PriorityMediumBrush" Color="#CA8A04" />

        <SolidColorBrush x:Key="PriorityLowBrush" Color="#16A34A" />

        <SolidColorBrush x:Key="DataGridHeaderBrush" Color="#ECFDF5" />

        <SolidColorBrush x:Key="DataGridAltRowBrush" Color="#F0FDF4" />



        <FontFamily x:Key="AppFont">Segoe UI</FontFamily>



        <Style x:Key="PageRoot" TargetType="Page">

            <Setter Property="Background" Value="{StaticResource PageBackgroundBrush}" />

            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />

        </Style>



        <Style x:Key="PageContent" TargetType="FrameworkElement">

            <Setter Property="Margin" Value="28,24,28,28" />

        </Style>



        <Style x:Key="CardBorder" TargetType="Border">

            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />

            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />

            <Setter Property="BorderThickness" Value="1" />

            <Setter Property="CornerRadius" Value="10" />

            <Setter Property="Padding" Value="18" />

        </Style>



        <Style x:Key="FormCard" TargetType="Border" BasedOn="{StaticResource CardBorder}">

            <Setter Property="Padding" Value="20" />

        </Style>



        <Style x:Key="FilterBar" TargetType="Border" BasedOn="{StaticResource CardBorder}">

            <Setter Property="Padding" Value="14,12" />

            <Setter Property="Margin" Value="0,0,0,16" />

        </Style>



        <Style x:Key="SectionTitle" TargetType="TextBlock">

            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />

            <Setter Property="FontSize" Value="28" />

            <Setter Property="FontWeight" Value="SemiBold" />

            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />

        </Style>



        <Style x:Key="SectionSubtitle" TargetType="TextBlock">

            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />

            <Setter Property="FontSize" Value="14" />

            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />

            <Setter Property="Margin" Value="0,6,0,20" />

            <Setter Property="TextWrapping" Value="Wrap" />

        </Style>



        <Style x:Key="CardHeader" TargetType="TextBlock">

            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />

            <Setter Property="FontSize" Value="15" />

            <Setter Property="FontWeight" Value="SemiBold" />

            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />

            <Setter Property="Margin" Value="0,0,0,12" />

        </Style>



        <Style x:Key="FormLabel" TargetType="TextBlock">

            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />

            <Setter Property="FontSize" Value="12" />

            <Setter Property="FontWeight" Value="SemiBold" />

            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />

            <Setter Property="Margin" Value="0,10,0,4" />

        </Style>



        <Style x:Key="ActionButtonBase" TargetType="Button">

            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />

            <Setter Property="FontSize" Value="13" />

            <Setter Property="Foreground" Value="White" />

            <Setter Property="Padding" Value="14,8" />

            <Setter Property="Margin" Value="0,0,8,8" />

            <Setter Property="BorderThickness" Value="0" />

            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Bd"

                                Background="{TemplateBinding Background}"

                                CornerRadius="8"

                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="Bd" Property="Opacity" Value="0.92" />

                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">

                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />

                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">

                                <Setter TargetName="Bd" Property="Opacity" Value="0.5" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <Style x:Key="BtnAdd" TargetType="Button" BasedOn="{StaticResource ActionButtonBase}">

            <Setter Property="Background" Value="{StaticResource AccentGreenBrush}" />

        </Style>



        <Style x:Key="BtnSave" TargetType="Button" BasedOn="{StaticResource ActionButtonBase}">

            <Setter Property="Background" Value="{StaticResource AccentSaveBrush}" />

        </Style>



        <Style x:Key="BtnDelete" TargetType="Button" BasedOn="{StaticResource ActionButtonBase}">

            <Setter Property="Background" Value="{StaticResource AccentRedBrush}" />

        </Style>



        <Style x:Key="BtnClear" TargetType="Button" BasedOn="{StaticResource ActionButtonBase}">

            <Setter Property="Background" Value="{StaticResource AccentGrayBrush}" />

        </Style>



        <Style x:Key="BtnSecondary" TargetType="Button" BasedOn="{StaticResource ActionButtonBase}">

            <Setter Property="Background" Value="{StaticResource SidebarHoverBrush}" />

            <Setter Property="Padding" Value="12,6" />

        </Style>



        <Style x:Key="NavSectionHeader" TargetType="TextBlock">

            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />

            <Setter Property="FontSize" Value="10" />

            <Setter Property="FontWeight" Value="Bold" />

            <Setter Property="Foreground" Value="{StaticResource SidebarMutedBrush}" />

            <Setter Property="Margin" Value="20,14,0,6" />

        </Style>



        <Style x:Key="NavButton" TargetType="Button">

            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />

            <Setter Property="Background" Value="Transparent" />

            <Setter Property="Foreground" Value="{StaticResource SidebarTextBrush}" />

            <Setter Property="HorizontalContentAlignment" Value="Left" />

            <Setter Property="Padding" Value="16,12" />

            <Setter Property="Margin" Value="12,3" />

            <Setter Property="BorderThickness" Value="0" />

            <Setter Property="FontSize" Value="14" />

            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="NavBd"

                                Background="{TemplateBinding Background}"

                                CornerRadius="10"

                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"

                                              VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="NavBd" Property="Background" Value="{StaticResource SidebarHoverBrush}" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <Style x:Key="NavButtonActive" TargetType="Button" BasedOn="{StaticResource NavButton}">

            <Setter Property="Background" Value="{StaticResource SidebarActiveBrush}" />

            <Setter Property="FontWeight" Value="SemiBold" />

            <Setter Property="Foreground" Value="White" />

        </Style>



        <Style x:Key="StatTile" TargetType="Border">

            <Setter Property="Background" Value="White" />

            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />

            <Setter Property="BorderThickness" Value="1,1,1,1" />

            <Setter Property="CornerRadius" Value="10" />

            <Setter Property="Padding" Value="22,18" />

            <Setter Property="Margin" Value="0,0,14,0" />

            <Setter Property="MinWidth" Value="190" />

        </Style>



        <Style x:Key="StatTileAccent" TargetType="Border" BasedOn="{StaticResource StatTile}">

            <Setter Property="BorderThickness" Value="4,1,1,1" />

            <Setter Property="BorderBrush" Value="{StaticResource AccentMintBrush}" />

        </Style>



        <Style x:Key="StatTileUrgent" TargetType="Border" BasedOn="{StaticResource StatTile}">

            <Setter Property="BorderThickness" Value="4,1,1,1" />

            <Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}" />

        </Style>



        <Style x:Key="StatLabel" TargetType="TextBlock">

            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />

            <Setter Property="FontSize" Value="13" />

            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />

        </Style>



        <Style TargetType="TextBox">

            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />

            <Setter Property="FontSize" Value="13" />

            <Setter Property="Padding" Value="8,6" />

            <Setter Property="MinHeight" Value="32" />

            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />

            <Setter Property="BorderThickness" Value="1" />

            <Setter Property="Background" Value="White" />

        </Style>



        <Style TargetType="ComboBox">

            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />

            <Setter Property="FontSize" Value="13" />

            <Setter Property="Padding" Value="8,6" />

            <Setter Property="MinHeight" Value="32" />

            <Setter Property="Background" Value="White" />

        </Style>



        <Style TargetType="DatePicker">

            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />

            <Setter Property="FontSize" Value="13" />

            <Setter Property="MinHeight" Value="32" />

        </Style>



        <Style x:Key="PriorityCellTextStyle" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Priority}" Value="Pilny">
                    <Setter Property="Foreground" Value="{StaticResource PriorityUrgentBrush}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Priority}" Value="Wysoki">
                    <Setter Property="Foreground" Value="{StaticResource PriorityHighBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Priority}" Value="Średni">
                    <Setter Property="Foreground" Value="{StaticResource PriorityMediumBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Priority}" Value="Niski">
                    <Setter Property="Foreground" Value="{StaticResource PriorityLowBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGrid">

            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />

            <Setter Property="FontSize" Value="13" />

            <Setter Property="Background" Value="White" />

            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />

            <Setter Property="BorderThickness" Value="0" />

            <Setter Property="RowBackground" Value="White" />

            <Setter Property="AlternatingRowBackground" Value="{StaticResource DataGridAltRowBrush}" />

            <Setter Property="GridLinesVisibility" Value="Horizontal" />

            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource AppBorderBrush}" />

            <Setter Property="HeadersVisibility" Value="Column" />

            <Setter Property="CanUserAddRows" Value="False" />

            <Setter Property="CanUserDeleteRows" Value="False" />

            <Setter Property="SelectionMode" Value="Single" />

            <Setter Property="SelectionUnit" Value="FullRow" />

        </Style>



        <Style TargetType="DataGridColumnHeader">

            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />

            <Setter Property="FontWeight" Value="SemiBold" />

            <Setter Property="FontSize" Value="12" />

            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />

            <Setter Property="Background" Value="{StaticResource DataGridHeaderBrush}" />

            <Setter Property="Padding" Value="10,8" />

            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />

            <Setter Property="BorderThickness" Value="0,0,0,1" />

        </Style>



        <Style TargetType="DataGridCell">

            <Setter Property="Padding" Value="10,6" />

            <Setter Property="BorderThickness" Value="0" />

        </Style>

    </Application.Resources>

</Application>

